# The firmware uses the Kbuild build system. There are 'Kbuild' files in this
# example that outlays what needs to be built. (check src/Kbuild).
#
# The firmware is configured using options in Kconfig files, the
# values of these end up in the .config file in the firmware directory.
#
# By setting the OOT_CONFIG (it is '$(PWD)/oot-config' by default) environment
# variable you can provide a custom configuration. It is important that you
# enable the app-layer. See app-config in this directory for example.

#
# We want to execute the main Makefile for the firmware project,
# it will handle the build for us.
#
CRAZYFLIE_BASE := ../../crazyflie-firmware

# On macOS, Crazyflie's merge_config.sh requires GNU readlink/sed/cp.
# If Homebrew gnubin shims exist, prepend them automatically.
COREUTILS_GNUBIN := $(firstword $(wildcard /opt/homebrew/opt/coreutils/libexec/gnubin) $(wildcard /usr/local/opt/coreutils/libexec/gnubin))
GNU_SED_GNUBIN := $(firstword $(wildcard /opt/homebrew/opt/gnu-sed/libexec/gnubin) $(wildcard /usr/local/opt/gnu-sed/libexec/gnubin))
ifneq ($(COREUTILS_GNUBIN),)
export PATH := $(COREUTILS_GNUBIN):$(PATH)
endif
ifneq ($(GNU_SED_GNUBIN),)
export PATH := $(GNU_SED_GNUBIN):$(PATH)
endif

#
# To include header files from other directories
#
# EXTRA_CFLAGS += -lstdc++
# EXTRA_CFLAGS += -lgcc
# EXTRA_CFLAGS += -lc
# EXTRA_CFLAGS += -lm
EXTRA_CFLAGS += -I$(CURDIR)/TinyMPC-ADMM/ext/Eigen
EXTRA_CFLAGS += -I$(CURDIR)/TinyMPC-ADMM/src
EXTRA_CFLAGS += -DEIGEN_INITIALIZE_MATRICES_BY_ZERO
EXTRA_CFLAGS += -DEIGEN_NO_MALLOC
EXTRA_CFLAGS += -DNDEBUG
EXTRA_CFLAGS += -Wno-unused-result
# The capture-time state channel uses a dedicated UART1 DMA sender task.
EXTRA_CFLAGS += -DENABLE_UART1_DMA

# Select the compiled level-flight reference.
TINYMPC_TRAJECTORY ?= circle
TINYMPC_ACTUATOR_LTI ?= 1
TINYMPC_RATE_CASCADE ?= 0
TINYMPC_DIRECT_PLAN_REPLAY ?= 0
TINYMPC_LEVEL_COST_MODE ?= baseline
TINYMPC_PROGRESS_SAMPLE_LIMIT ?= 0
TINYMPC_PROGRESS_SPEED_MPS ?= 0
TINYMPC_PROGRESS_LAPS ?= 1
TINYMPC_PROGRESS_ENTRY_ACCELERATION_MPS2 ?= 1.0
TINYMPC_PROGRESS_TERMINAL_DECELERATION_MPS2 ?= 6.0
TINYMPC_PROGRESS_REWARD_WEIGHT ?= 0.40
TINYMPC_FLIP_ENABLE ?= 0
TINYMPC_FLIP_TRIGGER_S_M ?= 1.0
TINYMPC_FLIP_TRIGGER_WINDOW_M ?= 0.25
TINYMPC_FLIP_DURATION_S ?= 0.8
TINYMPC_FLIP_PITCH_DIRECTION ?= 1
TINYMPC_POWER_LOOP_ENABLE ?= 0
TINYMPC_POWER_LOOP_TRIGGER_S_M ?= 1.0
TINYMPC_POWER_LOOP_TRIGGER_WINDOW_M ?= 0.25
TINYMPC_POWER_LOOP_RADIUS_M ?= 1.2
TINYMPC_POWER_LOOP_BOTTOM_SPEED_MPS ?= 2.2
TINYMPC_POWER_LOOP_TOP_SPEED_MPS ?= 4.0
TINYMPC_REACTIVE_POWER_LOOP ?= 0
TINYMPC_GATE_OLGMD_ENABLE ?= 0
TINYMPC_PATH_TUNNEL_ENABLE ?= 1
TINYMPC_PATH_TUNNEL_HALF_WIDTH_1_M ?= 0.30
TINYMPC_PATH_TUNNEL_HALF_WIDTH_2_M ?= 0.30
TINYMPC_VISION_RL_RESIDUAL_ENABLE ?= 0
TINYMPC_VISION_RESIDUAL_AUTHORITY_VERSION ?= 1
TINYMPC_MAXIMUM_LATERAL_RATE_MPS ?= 2.25
TINYMPC_VISION_RESIDUAL_LATERAL_RATE_LIMIT_MPS ?= $(TINYMPC_MAXIMUM_LATERAL_RATE_MPS)
TINYMPC_VISION_RESIDUAL_VERTICAL_RATE_LIMIT_MPS ?= 0.20
TINYMPC_VISION_RESIDUAL_GATE_LATERAL_OFFSET_LIMIT_M ?= 0.25
TINYMPC_VISION_RESIDUAL_FULL_LATERAL_OFFSET_LIMIT_M ?= 0.45
TINYMPC_VISION_RESIDUAL_VERTICAL_OFFSET_LIMIT_M ?= 0.25
TINYMPC_VISION_RESIDUAL_MIN_PROGRESS_SPEED_SCALE ?= 0.20
TINYMPC_VISION_RESIDUAL_MAX_PROGRESS_SPEED_SCALE ?= 1.00
TINYMPC_VERTICAL_ACTIVE_SENSING_ENABLE ?= 0
TINYMPC_VERTICAL_ACTIVE_SENSING_AMPLITUDE_M ?= 0.10
TINYMPC_VERTICAL_ACTIVE_SENSING_PERIOD_S ?= 2.0
TINYMPC_DIRECT_DRONET_SERVO ?= 0
TINYMPC_REACTIVE_REFERENCE_FREE ?= 0
# Set this to the validation-frozen value in the promoted v11 bundle.
TINYMPC_SQUARE_OPENING_THRESHOLD ?= 0.50
TINYMPC_COURSE ?= none
EXTRA_CFLAGS += -DTINYMPC_PROGRESS_SAMPLE_LIMIT=$(TINYMPC_PROGRESS_SAMPLE_LIMIT)
EXTRA_CFLAGS += -DTINYMPC_PROGRESS_SPEED_MPS=$(TINYMPC_PROGRESS_SPEED_MPS)
EXTRA_CFLAGS += -DTINYMPC_PROGRESS_LAPS=$(TINYMPC_PROGRESS_LAPS)
EXTRA_CFLAGS += -DTINYMPC_PROGRESS_ENTRY_ACCELERATION_MPS2=$(TINYMPC_PROGRESS_ENTRY_ACCELERATION_MPS2)
EXTRA_CFLAGS += -DTINYMPC_PROGRESS_TERMINAL_DECELERATION_MPS2=$(TINYMPC_PROGRESS_TERMINAL_DECELERATION_MPS2)
EXTRA_CFLAGS += -DTINYMPC_PROGRESS_REWARD_WEIGHT=$(TINYMPC_PROGRESS_REWARD_WEIGHT)
EXTRA_CFLAGS += -DTINYMPC_FLIP_ENABLE=$(TINYMPC_FLIP_ENABLE)
EXTRA_CFLAGS += -DTINYMPC_FLIP_TRIGGER_S_M=$(TINYMPC_FLIP_TRIGGER_S_M)
EXTRA_CFLAGS += -DTINYMPC_FLIP_TRIGGER_WINDOW_M=$(TINYMPC_FLIP_TRIGGER_WINDOW_M)
EXTRA_CFLAGS += -DTINYMPC_FLIP_DURATION_S=$(TINYMPC_FLIP_DURATION_S)
EXTRA_CFLAGS += -DTINYMPC_FLIP_PITCH_DIRECTION=$(TINYMPC_FLIP_PITCH_DIRECTION)
EXTRA_CFLAGS += -DTINYMPC_POWER_LOOP_ENABLE=$(TINYMPC_POWER_LOOP_ENABLE)
EXTRA_CFLAGS += -DTINYMPC_POWER_LOOP_TRIGGER_S_M=$(TINYMPC_POWER_LOOP_TRIGGER_S_M)
EXTRA_CFLAGS += -DTINYMPC_POWER_LOOP_TRIGGER_WINDOW_M=$(TINYMPC_POWER_LOOP_TRIGGER_WINDOW_M)
EXTRA_CFLAGS += -DTINYMPC_POWER_LOOP_RADIUS_M=$(TINYMPC_POWER_LOOP_RADIUS_M)
EXTRA_CFLAGS += -DTINYMPC_POWER_LOOP_BOTTOM_SPEED_MPS=$(TINYMPC_POWER_LOOP_BOTTOM_SPEED_MPS)
EXTRA_CFLAGS += -DTINYMPC_POWER_LOOP_TOP_SPEED_MPS=$(TINYMPC_POWER_LOOP_TOP_SPEED_MPS)
EXTRA_CFLAGS += -DTINYMPC_REACTIVE_POWER_LOOP_ENABLE=$(TINYMPC_REACTIVE_POWER_LOOP)
EXTRA_CFLAGS += -DTINYMPC_GATE_OLGMD_ENABLE=$(TINYMPC_GATE_OLGMD_ENABLE)
EXTRA_CFLAGS += -DTINYMPC_PATH_TUNNEL_ENABLE=$(TINYMPC_PATH_TUNNEL_ENABLE)
EXTRA_CFLAGS += -DTINYMPC_PATH_TUNNEL_HALF_WIDTH_1_M=$(TINYMPC_PATH_TUNNEL_HALF_WIDTH_1_M)
EXTRA_CFLAGS += -DTINYMPC_PATH_TUNNEL_HALF_WIDTH_2_M=$(TINYMPC_PATH_TUNNEL_HALF_WIDTH_2_M)
EXTRA_CFLAGS += -DTINYMPC_VISION_RL_RESIDUAL_ENABLE=$(TINYMPC_VISION_RL_RESIDUAL_ENABLE)
EXTRA_CFLAGS += -DTINYMPC_MAXIMUM_LATERAL_RATE_MPS=$(TINYMPC_MAXIMUM_LATERAL_RATE_MPS)
EXTRA_CFLAGS += -DTINYMPC_VISION_RESIDUAL_AUTHORITY_VERSION=$(TINYMPC_VISION_RESIDUAL_AUTHORITY_VERSION)
EXTRA_CFLAGS += -DTINYMPC_VISION_RESIDUAL_LATERAL_RATE_LIMIT_MPS=$(TINYMPC_VISION_RESIDUAL_LATERAL_RATE_LIMIT_MPS)
EXTRA_CFLAGS += -DTINYMPC_VISION_RESIDUAL_VERTICAL_RATE_LIMIT_MPS=$(TINYMPC_VISION_RESIDUAL_VERTICAL_RATE_LIMIT_MPS)
EXTRA_CFLAGS += -DTINYMPC_VISION_RESIDUAL_GATE_LATERAL_OFFSET_LIMIT_M=$(TINYMPC_VISION_RESIDUAL_GATE_LATERAL_OFFSET_LIMIT_M)
EXTRA_CFLAGS += -DTINYMPC_VISION_RESIDUAL_FULL_LATERAL_OFFSET_LIMIT_M=$(TINYMPC_VISION_RESIDUAL_FULL_LATERAL_OFFSET_LIMIT_M)
EXTRA_CFLAGS += -DTINYMPC_VISION_RESIDUAL_VERTICAL_OFFSET_LIMIT_M=$(TINYMPC_VISION_RESIDUAL_VERTICAL_OFFSET_LIMIT_M)
EXTRA_CFLAGS += -DTINYMPC_VISION_RESIDUAL_MIN_PROGRESS_SPEED_SCALE=$(TINYMPC_VISION_RESIDUAL_MIN_PROGRESS_SPEED_SCALE)
EXTRA_CFLAGS += -DTINYMPC_VISION_RESIDUAL_MAX_PROGRESS_SPEED_SCALE=$(TINYMPC_VISION_RESIDUAL_MAX_PROGRESS_SPEED_SCALE)
EXTRA_CFLAGS += -DTINYMPC_VERTICAL_ACTIVE_SENSING_ENABLE=$(TINYMPC_VERTICAL_ACTIVE_SENSING_ENABLE)
EXTRA_CFLAGS += -DTINYMPC_VERTICAL_ACTIVE_SENSING_AMPLITUDE_M=$(TINYMPC_VERTICAL_ACTIVE_SENSING_AMPLITUDE_M)
EXTRA_CFLAGS += -DTINYMPC_VERTICAL_ACTIVE_SENSING_PERIOD_S=$(TINYMPC_VERTICAL_ACTIVE_SENSING_PERIOD_S)
EXTRA_CFLAGS += -DTINYMPC_RATE_CASCADE=$(TINYMPC_RATE_CASCADE)
EXTRA_CFLAGS += -DTINYMPC_DIRECT_DRONET_SERVO=$(TINYMPC_DIRECT_DRONET_SERVO)
EXTRA_CFLAGS += -DTINYMPC_REACTIVE_REFERENCE_FREE=$(TINYMPC_REACTIVE_REFERENCE_FREE)
EXTRA_CFLAGS += -DTINYMPC_SQUARE_OPENING_THRESHOLD=$(TINYMPC_SQUARE_OPENING_THRESHOLD)f
ifeq ($(filter $(TINYMPC_VISION_RL_RESIDUAL_ENABLE),0 1),)
$(error TINYMPC_VISION_RL_RESIDUAL_ENABLE must be 0 or 1)
endif
ifneq ($(TINYMPC_VISION_RESIDUAL_AUTHORITY_VERSION),1)
$(error TINYMPC_VISION_RESIDUAL_AUTHORITY_VERSION must be 1)
endif
ifeq ($(filter $(TINYMPC_VERTICAL_ACTIVE_SENSING_ENABLE),0 1),)
$(error TINYMPC_VERTICAL_ACTIVE_SENSING_ENABLE must be 0 or 1)
endif
ifeq ($(filter $(TINYMPC_RATE_CASCADE),0 1),)
$(error TINYMPC_RATE_CASCADE must be 0 or 1)
endif
ifeq ($(filter $(TINYMPC_DIRECT_DRONET_SERVO),0 1),)
$(error TINYMPC_DIRECT_DRONET_SERVO must be 0 or 1)
endif
ifeq ($(filter $(TINYMPC_REACTIVE_REFERENCE_FREE),0 1),)
$(error TINYMPC_REACTIVE_REFERENCE_FREE must be 0 or 1)
endif
ifeq ($(filter $(TINYMPC_GATE_OLGMD_ENABLE),0 1),)
$(error TINYMPC_GATE_OLGMD_ENABLE must be 0 or 1)
endif
ifeq ($(filter $(TINYMPC_FLIP_ENABLE),0 1),)
$(error TINYMPC_FLIP_ENABLE must be 0 or 1)
endif
ifeq ($(filter $(TINYMPC_FLIP_PITCH_DIRECTION),-1 1),)
$(error TINYMPC_FLIP_PITCH_DIRECTION must be -1 or 1)
endif
ifeq ($(filter $(TINYMPC_POWER_LOOP_ENABLE),0 1),)
$(error TINYMPC_POWER_LOOP_ENABLE must be 0 or 1)
endif
ifeq ($(TINYMPC_FLIP_ENABLE)$(TINYMPC_POWER_LOOP_ENABLE),11)
$(error TINYMPC_FLIP_ENABLE and TINYMPC_POWER_LOOP_ENABLE are mutually exclusive)
endif
ifeq ($(filter $(TINYMPC_PROGRESS_LAPS),1 2 3 4 5 6 7 8),)
$(error TINYMPC_PROGRESS_LAPS must be an integer from 1 through 8)
endif
ifneq ($(TINYMPC_PROGRESS_LAPS),1)
ifeq ($(filter $(TINYMPC_TRAJECTORY),circle imav22_circle),)
$(error repeated TINYMPC_PROGRESS_LAPS requires a closed circle trajectory)
endif
endif
ifeq ($(TINYMPC_LEVEL_COST_MODE),yaw_angle_4x)
EXTRA_CFLAGS += -DTINYMPC_LEVEL_COST_YAW_ANGLE_4X=1
else ifeq ($(TINYMPC_LEVEL_COST_MODE),yaw_rate_4x)
EXTRA_CFLAGS += -DTINYMPC_LEVEL_COST_YAW_RATE_4X=1
else ifeq ($(TINYMPC_LEVEL_COST_MODE),yaw_diff_r_quarter)
EXTRA_CFLAGS += -DTINYMPC_LEVEL_COST_YAW_DIFF_R_QUARTER=1
else ifneq ($(TINYMPC_LEVEL_COST_MODE),baseline)
$(error TINYMPC_LEVEL_COST_MODE must be baseline, yaw_angle_4x, yaw_rate_4x, or yaw_diff_r_quarter)
endif
ifneq ($(TINYMPC_LEVEL_COST_MODE),baseline)
ifneq ($(TINYMPC_ACTUATOR_LTI),1)
$(error non-baseline TINYMPC_LEVEL_COST_MODE requires TINYMPC_ACTUATOR_LTI=1)
endif
endif
ifeq ($(TINYMPC_COURSE),canonical_circle)
EXTRA_CFLAGS += -DTINYMPC_COURSE_CANONICAL_CIRCLE=1
endif
ifeq ($(TINYMPC_TRAJECTORY),straight)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_STRAIGHT=1
else ifeq ($(TINYMPC_TRAJECTORY),straight_long)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_STRAIGHT_LONG=1
else ifeq ($(TINYMPC_TRAJECTORY),straight_9m)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_STRAIGHT_9M=1
else ifeq ($(TINYMPC_TRAJECTORY),straight_20m)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_STRAIGHT_20M=1
else ifeq ($(TINYMPC_TRAJECTORY),canonical_corridor)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_CANONICAL_CORRIDOR=1
else ifeq ($(TINYMPC_TRAJECTORY),canonical_circle)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_CANONICAL_CIRCLE=1
else ifeq ($(TINYMPC_TRAJECTORY),imav22_circle)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_IMAV22_CIRCLE=1
else ifeq ($(TINYMPC_TRAJECTORY),figure8)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_FIGURE8=1
else ifeq ($(TINYMPC_TRAJECTORY),oval)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_OVAL=1
else ifeq ($(TINYMPC_TRAJECTORY),canonical_figure8)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_CANONICAL_FIGURE8=1
else ifeq ($(TINYMPC_TRAJECTORY),chicane)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_CHICANE=1
else ifeq ($(TINYMPC_TRAJECTORY),canonical_chicane)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_CANONICAL_CHICANE=1
else ifeq ($(TINYMPC_TRAJECTORY),hairpin_180)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_HAIRPIN_180=1
else ifeq ($(TINYMPC_TRAJECTORY),canonical_hairpin)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_CANONICAL_HAIRPIN=1
else ifeq ($(TINYMPC_TRAJECTORY),dronet_u)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_DRONET_U=1
else ifeq ($(TINYMPC_TRAJECTORY),circle)
EXTRA_CFLAGS += -DTINYMPC_TRAJECTORY_CIRCLE=1
else ifneq ($(TINYMPC_TRAJECTORY),circle)
$(error Unsupported TINYMPC_TRAJECTORY '$(TINYMPC_TRAJECTORY)')
endif
ifeq ($(TINYMPC_ACTUATOR_LTI),1)
EXTRA_CFLAGS += -DTINYMPC_USE_ACTUATOR_LTI=1
else ifneq ($(TINYMPC_ACTUATOR_LTI),0)
$(error TINYMPC_ACTUATOR_LTI must be 0 or 1)
endif
ifeq ($(TINYMPC_FLIP_ENABLE),1)
ifneq ($(TINYMPC_ACTUATOR_LTI),1)
$(error TINYMPC_FLIP_ENABLE=1 requires TINYMPC_ACTUATOR_LTI=1)
endif
endif
ifeq ($(TINYMPC_POWER_LOOP_ENABLE),1)
ifneq ($(TINYMPC_ACTUATOR_LTI),1)
$(error TINYMPC_POWER_LOOP_ENABLE=1 requires TINYMPC_ACTUATOR_LTI=1)
endif
endif
ifeq ($(TINYMPC_DIRECT_PLAN_REPLAY),1)
ifneq ($(TINYMPC_RATE_CASCADE),0)
$(error TINYMPC_DIRECT_PLAN_REPLAY=1 requires TINYMPC_RATE_CASCADE=0)
endif
ifneq ($(TINYMPC_ACTUATOR_LTI),1)
$(error TINYMPC_DIRECT_PLAN_REPLAY=1 requires TINYMPC_ACTUATOR_LTI=1)
endif
EXTRA_CFLAGS += -DTINYMPC_DIRECT_PLAN_REPLAY=1
else ifneq ($(TINYMPC_DIRECT_PLAN_REPLAY),0)
$(error TINYMPC_DIRECT_PLAN_REPLAY must be 0 or 1)
endif
#
# We override the default OOT_CONFIG here, we could also name our config
# to oot-config and that would be the default.
#
OOT_CONFIG := $(CURDIR)/app-config

OOT_USES_CXX := 1

include $(CRAZYFLIE_BASE)/tools/make/oot.mk

# The upstream OOT `cload` target only transfers the existing binary.  Make
# flashing safe after a source update: build the app first so `make cload`
# cannot silently reinstall a stale cf21bl.bin lacking new parameters/logs.
cload: all
