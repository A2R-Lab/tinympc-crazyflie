+// SIM channel 3: four little-endian float32 newtons, tick, sequence.
+static bool directThrustMode = false;
+static float directThrustN[4];
+
+static void packU32LE(uint8_t *dst, uint32_t value) {
+  for (unsigned i = 0; i < 4; ++i) dst[i] = (uint8_t)(value >> (8 * i));
+}
+
 static uint32_t lastSentTime = 0;
