@@ -155,6 +163,15 @@
 
 void powerDistribution(const control_t *control, motors_thrust_uncapped_t* motorThrustUncapped)
 {
+  directThrustMode = control->controlMode == controlModeMotorThrustSI;
+  if (directThrustMode) {
+    for (unsigned i = 0; i < 4; ++i) {
+      const float thrust = control->motorThrustN[i];
+      directThrustN[i] = isfinite(thrust) && thrust >= 0.0f ? thrust : 0.0f;
+      motorThrustUncapped->list[i] = 0; // do not route SI through PWM caps
+    }
+    return;
+  }
