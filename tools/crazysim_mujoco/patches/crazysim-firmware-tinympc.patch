+typedef enum {
+  EstimatorAidingInhibitNone = 0,
+  EstimatorAidingInhibitFlow = 1 << 0,
+  EstimatorAidingInhibitDownRange = 1 << 1,
+} estimatorAidingInhibit_t;
+
+/* A controller may temporarily inhibit geometrically invalid external aiding
+ * while the estimator continues normal IMU prediction and process-noise
+ * propagation. The queue is still drained, so stale measurements are never
+ * fused when aiding is restored. */
+void estimatorSetAidingInhibit(uint8_t inhibitMask);
+uint8_t estimatorGetAidingInhibit(void);
+
