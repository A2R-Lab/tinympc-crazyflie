+    def _configure_imav22_environment(self):
+        if self._imav22_mode is None:
+            return
+        if self._imav22_mode not in ('gates', 'static', 'dynamic'):
+            raise ValueError('imav22_mode must be gates, static, or dynamic')
+        if self._imav22_object_set not in ('official', 'extended'):
+            raise ValueError('imav22_object_set must be official or extended')
+        if self._imav22_mode == 'gates' and self._imav22_object_set != 'official':
+            raise ValueError('IMAV22 gates mode supports only the official object set')
+        if min(self._imav22_relocation_period,
+               self._imav22_relocation_clearance,
+               self._imav22_relocation_duration) <= 0.0:
+            raise ValueError('IMAV22 relocation parameters must be positive')
+        if self._imav22_relocation_duration >= self._imav22_relocation_period:
+            raise ValueError('IMAV22 relocation duration must be shorter than its period')
+
+        obstacle_prefixes = ('imav_orange_pole_', 'imav_black_panel_', 'imav_flag_')
+        if self._imav22_mode == 'gates':
+            hidden = 0
+            for geom_id in range(self.model.ngeom):
+                name = mujoco.mj_id2name(
+                    self.model, mujoco.mjtObj.mjOBJ_GEOM, geom_id) or ''
+                if name.startswith(obstacle_prefixes):
+                    self.model.geom_contype[geom_id] = 0
+                    self.model.geom_conaffinity[geom_id] = 0
+                    self.model.geom_rgba[geom_id, 3] = 0.0
+                    hidden += 1
+            if hidden != 22:
+                raise ValueError(
+                    f'IMAV22 gates mode expected 22 non-gate geoms, found {hidden}')
+        if self._imav22_object_set == 'extended':
+            enabled = 0
+            for geom_id in range(self.model.ngeom):
+                name = mujoco.mj_id2name(
+                    self.model, mujoco.mjtObj.mjOBJ_GEOM, geom_id) or ''
+                if name.startswith('imav_extra_'):
+                    self.model.geom_contype[geom_id] = 1
+                    self.model.geom_conaffinity[geom_id] = 1
+                    self.model.geom_rgba[geom_id, 3] = 1.0
+                    enabled += 1
+            if enabled != 11:
+                raise ValueError(
+                    f'IMAV22 extended set expected 11 extra geoms, found {enabled}')
+        if self._imav22_mode == 'dynamic':
+            mujoco.mj_forward(self.model, self.data)
+            for body_id in range(self.model.nbody):
+                name = mujoco.mj_id2name(
+                    self.model, mujoco.mjtObj.mjOBJ_BODY, body_id) or ''
+                if not name.startswith('imav_dynamic_'):
+                    continue
+                mocap_id = int(self.model.body_mocapid[body_id])
+                if mocap_id < 0:
+                    raise ValueError(f'IMAV22 dynamic body is not mocap: {name}')
+                target_id = mujoco.mj_name2id(
+                    self.model, mujoco.mjtObj.mjOBJ_SITE, f'{name}_target')
+                if target_id < 0:
+                    raise ValueError(f'IMAV22 dynamic body lacks target site: {name}')
+                target_quat = np.empty(4, dtype=float)
+                mujoco.mju_mat2Quat(target_quat, self.data.site_xmat[target_id])
+                self._imav22_dynamic.append({
+                    'name': name,
+                    'mocap_id': mocap_id,
+                    'start': self.data.mocap_pos[mocap_id].copy(),
+                    'target': self.data.site_xpos[target_id].copy(),
+                    'start_quat': self.data.mocap_quat[mocap_id].copy(),
+                    'target_quat': target_quat,
+                    'radius': (0.50 if 'panel' in name else
+                               0.40 if 'flag' in name else 0.15),
+                })
+            if not self._imav22_dynamic:
+                raise ValueError('IMAV22 dynamic mode found no imav_dynamic_* bodies')
+        print(f'[crazysim] IMAV22 mode : {self._imav22_mode} '
+              f'objects={self._imav22_object_set}')
+
+    def _log_imav22_event(self, event: str, cycle: int, detail: str = ''):
+        if self._imav22_event_writer is not None:
+            self._imav22_event_writer.writerow([
+                f'{self.data.time:.9f}', event, cycle, detail])
+
+    def _update_imav22_dynamic_obstacles(self):
+        if self._imav22_mode != 'dynamic':
+            return
+        if self._imav22_transition is not None:
+            transition = self._imav22_transition
+            u = min(1.0, max(0.0, (self.data.time - transition['start_time']) /
+                                  self._imav22_relocation_duration))
+            alpha = u * u * (3.0 - 2.0 * u)
+            item = transition['item']
+            self.data.mocap_pos[item['mocap_id']] = (
+                transition['origin'] + alpha *
+                (transition['destination'] - transition['origin']))
+            origin_quat = transition['origin_quat']
+            destination_quat = transition['destination_quat']
+            if float(origin_quat @ destination_quat) < 0.0:
+                destination_quat = -destination_quat
+            quat = (1.0 - alpha) * origin_quat + alpha * destination_quat
+            self.data.mocap_quat[item['mocap_id']] = quat / np.linalg.norm(quat)
+            if u >= 1.0:
+                self._imav22_cycle = transition['cycle']
+                self._log_imav22_event('complete', self._imav22_cycle)
+                self._imav22_transition = None
+            return
+
+        requested_cycle = int(self.data.time // self._imav22_relocation_period)
+        if requested_cycle <= self._imav22_cycle:
+            return
+        item_index = (requested_cycle - 1) % len(self._imav22_dynamic)
+        item = self._imav22_dynamic[item_index]
+        visit = (requested_cycle - 1) // len(self._imav22_dynamic)
+        destination = item['target'] if visit % 2 == 0 else item['start']
+        destination_quat = (
+            item['target_quat'] if visit % 2 == 0 else item['start_quat'])
+        drone_xy = [self.data.xpos[agent._body_id, :2] for agent in self.agents]
+        def segment_distance(point, start, finish):
+            segment = finish - start
+            denominator = float(segment @ segment)
+            fraction = 0.0 if denominator <= 1.0e-12 else float(
+                np.clip(((point - start) @ segment) / denominator, 0.0, 1.0))
+            return float(np.linalg.norm(point - (start + fraction * segment)))
+
+        safe = all(
+            segment_distance(
+                drone,
+                self.data.mocap_pos[item['mocap_id'], :2], destination[:2]) >=
+            self._imav22_relocation_clearance + item['radius']
+            for drone in drone_xy
+        )
+        if not safe:
+            if self._imav22_delayed_cycle != requested_cycle:
+                self._log_imav22_event('delayed_for_clearance', requested_cycle)
+                self._imav22_delayed_cycle = requested_cycle
+            return
+        self._imav22_delayed_cycle = None
+        self._imav22_transition = {
+            'cycle': requested_cycle,
+            'start_time': self.data.time,
+            'item': item,
+            'origin': self.data.mocap_pos[item['mocap_id']].copy(),
+            'destination': destination,
+            'origin_quat': self.data.mocap_quat[item['mocap_id']].copy(),
+            'destination_quat': destination_quat,
+        }
+        self._log_imav22_event('start', requested_cycle,
+                               f"object={item['name']}")
+
