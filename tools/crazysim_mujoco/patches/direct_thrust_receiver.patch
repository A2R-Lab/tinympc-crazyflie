+    def _thrust_to_rpm(self, thrust: float) -> float:
+        """Desired N to target RPM; no normalized-command thrust curve."""
+        if not math.isfinite(thrust) or thrust < 0.0:
+            raise ValueError('motor thrust must be finite and nonnegative')
+        if thrust == 0.0:
+            return 0.0
         a, b, c = self._params.rpm2thrust
         # Solve c*rpm² + b*rpm + (a - thrust) = 0
         disc = b * b - 4.0 * c * (a - thrust)
@@ -789,6 +806,23 @@
             return 0.0
         rpm = (-b + math.sqrt(disc)) / (2.0 * c)
         return min(max(rpm, 0.0), self._params.max_rpm)
