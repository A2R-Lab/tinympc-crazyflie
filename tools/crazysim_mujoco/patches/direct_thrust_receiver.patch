+    def _accept_thrust_packet(self, data: bytes) -> bool:
+        """Atomically accept a versioned-by-channel, exact-size SI thrust packet."""
+        if len(data) != 25 or data[0] != CRTP_HDR_THRUST:
+            return False
+        *forces, tick, sequence = struct.unpack_from('<ffffII', data, 1)
+        if any(not math.isfinite(t) or t < 0.0 for t in forces):
+            return False
+        targets = [self._thrust_to_rpm(t) for t in forces]
+        with self._motor_lock:
+            self._thrust_requested[:] = forces
+            self._rpm_ref[:] = targets
+            self._firmware_tick = tick
+            self._stabilizer_sequence = sequence
+            self._motor_command_mode = 1
+            self._motor_command_packet_count += 1
+        return True
 
